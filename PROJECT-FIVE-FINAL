# Function to get the execution ARN from S3
def get_execution_arn_from_s3():
    try:
        # Fetch the JSON file containing the execution ARN from S3
        response = s3.get_object(Bucket=S3_BUCKET_NAME, Key=S3_FILE_KEY)
        arn_data = json.loads(response['Body'].read().decode('utf-8'))
        return arn_data.get('execution_arn', None)
    except Exception as e:
        st.error(f"Error fetching execution ARN from S3: {e}")
        return None

# Function to check Step Function execution status
def check_step_function_status(execution_arn):
    try:
        # Describe the Step Function execution
        response = step_functions.describe_execution(
            executionArn=execution_arn
        )
        return response['status']
    except Exception as e:
        st.error(f"Error checking Step Function status: {e}")
        return None

# Polling for the Step Function status
def poll_step_function_status(execution_arn, max_retries=10, delay=5):
    retries = 0
    status = check_step_function_status(execution_arn)
    
    # Keep polling until it reaches a terminal state or retries exceed max_retries
    while status not in ["SUCCEEDED", "FAILED", "TIMED_OUT"] and retries < max_retries:
        time.sleep(delay)
        status = check_step_function_status(execution_arn)
        retries += 1
    
    return status

# Fetch execution ARN from S3 and monitor the status
if st.button("Check Step Function Status"):
    execution_arn = get_execution_arn_from_s3()
    if execution_arn:
        st.write(f"Execution ARN: {execution_arn}")
        status = poll_step_function_status(execution_arn)
        
        if status:
            st.write(f"Step Function Status: {status}")
            if status == "SUCCEEDED":
                st.success("Step Function executed successfully.")
            elif status == "FAILED":
                st.error("Step Function execution failed.")
            elif status == "TIMED_OUT":
                st.warning("Step Function timed out.")
            else:
                st.info(f"Step Function is still {status}.")
        else:
            st.error("Failed to retrieve Step Function status.")
    else:
        st.warning("No execution ARN found.")



