# Initialize GlueContext
sc = SparkContext()
glueContext = GlueContext(sc)
spark = glueContext.spark_session

# Initialize S3 client
s3 = boto3.client('s3')

# S3 Buckets for Orders and Returns
orders_bucket = 'ecommerce-orders-bucket'
returns_bucket = 'ecommerce-returns-bucket'

# Function to get the latest file from an S3 bucket
def get_latest_s3_file(bucket_name):
    objects = s3.list_objects_v2(Bucket=bucket_name)
    if 'Contents' in objects:
        latest_file = max(objects['Contents'], key=lambda x: x['LastModified'])
        return latest_file['Key']  # Returns the file name (key)
    else:
        raise Exception(f"No files found in bucket {bucket_name}")

# Get the latest file uploaded in Orders and Returns buckets
orders_file_key = get_latest_s3_file(orders_bucket)
returns_file_key = get_latest_s3_file(returns_bucket)

# S3 paths for Orders and Returns (with the dynamically captured file names)
orders_s3_path = f"s3://{orders_bucket}/{orders_file_key}"
returns_s3_path = f"s3://{returns_bucket}/{returns_file_key}"

# Read Orders and Returns data into separate dataframes
orders_df = spark.read.format("csv").option("header", "true").load(orders_s3_path)
returns_df = spark.read.format("csv").option("header", "true").load(returns_s3_path)

# Filter both dataframes where OrderID is not null
orders_df_filtered = orders_df.filter(col("OrderID").isNotNull())
returns_df_filtered = returns_df.filter(col("OrderID").isNotNull())

# Perform a left join on OrderID, keeping all records from Orders
joined_df = orders_df_filtered.join(returns_df_filtered, on="OrderID", how="left")

# Output the resulting schema (optional)
joined_df.printSchema()

