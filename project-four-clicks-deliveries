import boto3
import json
import random
import time

# Initialize Kinesis client with Access Key, Secret Key, and Region
kinesis_client = boto3.client(
    'kinesis',
    aws_access_key_id='',   # Replace with your Access Key ID
    aws_secret_access_key='',  # Replace with your Secret Key
    region_name='us-east-1'  # Replace with your AWS Region
)

def send_clickstream_data(max_records):
    count = 0
    while count < max_records:
        data = {
            'ItemID': random.choice(['MOBILE001', 'LAPTOP001', 'CAMERA001']),
            'ItemName': random.choice(['Mobile Phone', 'Laptop', 'Camera']),
            'ClickCount': random.randint(1, 10),
            'Timestamp': time.time()  # Unix timestamp
        }
        kinesis_client.put_record(
            StreamName='ClickstreamDataStream',  # Use consistent stream name
            Data=json.dumps(data),
            PartitionKey='partition-key'
        )
        print(f"Sent clickstream data: {data}")
        count += 1
        time.sleep(1)  # Wait 1 second before sending the next record

if __name__ == "__main__":
    max_records = 5  # Set the maximum number of records to send
    send_clickstream_data(max_records)


