import json
import boto3
import base64
from datetime import datetime
import time  # Import the time module

# Initialize DynamoDB resource
dynamodb = boto3.resource('dynamodb')
table = dynamodb.Table('ClickstreamDataTable')  # Ensure this matches your DynamoDB table name

def lambda_handler(event, context):
    try:
        # Check if 'Records' key exists in the event
        if 'Records' not in event:
            print(f"Invalid event: {json.dumps(event)}")
            return {
                'statusCode': 400,
                'body': json.dumps('Invalid event, no Records key')
            }
        
        for record in event['Records']:
            # Decode the Base64-encoded Kinesis data
            payload = base64.b64decode(record['kinesis']['data']).decode('utf-8')
            data = json.loads(payload)

            # Extract relevant fields from the data
            item_id = data.get('ItemID', 'Unknown')
            item_name = data.get('ItemName', 'Unknown')
            click_count = int(data.get('ClickCount', 0))
            timestamp = float(data.get('Timestamp', time.time()))

            # Insert data into DynamoDB table
            table.put_item(
                Item={
                    'ItemID': item_id,
                    'ItemName': item_name,
                    'ClickCount': click_count,
                    'Timestamp': str(datetime.fromtimestamp(timestamp))  # Store as string in ISO format
                }
            )
        return {
            'statusCode': 200,
            'body': json.dumps('Clickstream data processed successfully')
        }

    except Exception as e:
        print(f"Error processing data: {str(e)}")
        return {
            'statusCode': 500,
            'body': str(e)
        }


import json
import boto3
import base64
from datetime import datetime
import time
from decimal import Decimal  # Import Decimal to handle DynamoDB number types

# Initialize DynamoDB resource
dynamodb = boto3.resource('dynamodb')
table = dynamodb.Table('TruckTelemetryTable')  # Ensure this matches your DynamoDB table name

# Helper function to convert float values to Decimal recursively in nested dictionaries
def convert_to_decimal(data):
    if isinstance(data, list):
        return [convert_to_decimal(v) for v in data]
    elif isinstance(data, dict):
        return {k: convert_to_decimal(v) for k, v in data.items()}
    elif isinstance(data, float):
        return Decimal(str(data))  # Convert float to Decimal
    else:
        return data

def lambda_handler(event, context):
    try:
        # Check if 'Records' key exists in the event
        if 'Records' not in event:
            print(f"Invalid event: {json.dumps(event)}")
            return {
                'statusCode': 400,
                'body': json.dumps('Invalid event, no Records key')
            }
        
        for record in event['Records']:
            # Decode the Base64-encoded Kinesis data
            payload = base64.b64decode(record['kinesis']['data']).decode('utf-8')
            data = json.loads(payload)

            # Convert float values in the telemetry data to Decimal
            data = convert_to_decimal(data)

            # Extract relevant fields from the payload
            truck_id = data.get('TruckID', 'Unknown')
            gps_location = data.get('GPSLocation', {})
            engine_diagnostics = data.get('EngineDiagnostics', {})
            odometer_reading = data.get('OdometerReading', 0)
            timestamp = data.get('Timestamp', Decimal(str(time.time())))

            # Insert data into DynamoDB table
            table.put_item(
                Item={
                    'TruckID': truck_id,
                    'Timestamp': str(datetime.fromtimestamp(float(timestamp))),  # Store as string in ISO format
                    'GPSLocation': gps_location,
                    'EngineDiagnostics': engine_diagnostics,
                    'OdometerReading': odometer_reading
                }
            )
        return {
            'statusCode': 200,
            'body': json.dumps('Truck telemetry data processed successfully')
        }

    except Exception as e:
        print(f"Error processing data: {str(e)}")
        return {
            'statusCode': 500,
            'body': str(e)
        }
